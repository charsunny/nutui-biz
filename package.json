{
  "name": "nutui-biz-taro",
  "version": "2.0.0-alpha.0",
  "private": true,
  "description": "京东风格的业务组件库 (Taro 4 + NutUI React Taro 3), fork 自 jdf2e/nutui-biz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/charsunny/nutui-biz.git"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "sideEffects": [
    "*.scss",
    "*.css",
    "src/packages/*/index.ts"
  ],
  "scripts": {
    "gen": "node scripts/generate.mjs",
    "check-types": "npm run gen && tsc --noEmit",
    "test": "bun test tests",
    "dev:weapp": "npm run gen && taro build --type weapp --watch",
    "dev:h5": "npm run gen && taro build --type h5 --watch",
    "build:weapp": "npm run gen && taro build --type weapp",
    "build:h5": "npm run gen && taro build --type h5"
  },
  "peerDependencies": {
    "@nutui/icons-react-taro": ">=3.0.2-cpp.3.beta.9 <4",
    "@nutui/nutui-react-taro": "^3.0.19",
    "@tarojs/components": "^4.0.0",
    "@tarojs/taro": "^4.0.0",
    "react": "^18.0.0"
  },
  "dependencies": {
    "@bem-react/classname": "^1.5.10",
    "classnames": "^2.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/plugin-transform-class-properties": "7.25.9",
    "@babel/preset-react": "^7.24.1",
    "@babel/runtime": "^7.24.4",
    "@nutui/icons-react-taro": "3.0.2-cpp.3.beta.9",
    "@nutui/nutui-react-taro": "3.0.19",
    "@tarojs/cli": "4.2.1",
    "@tarojs/components": "4.2.1",
    "@tarojs/helper": "4.2.1",
    "@tarojs/plugin-framework-react": "4.2.1",
    "@tarojs/plugin-platform-h5": "4.2.1",
    "@tarojs/plugin-platform-weapp": "4.2.1",
    "@tarojs/react": "4.2.1",
    "@tarojs/runtime": "4.2.1",
    "@tarojs/shared": "4.2.1",
    "@tarojs/taro": "4.2.1",
    "@tarojs/taro-loader": "4.2.1",
    "@tarojs/webpack5-runner": "4.2.1",
    "@types/node": "^18",
    "@types/react": "^18.3.0",
    "@types/webpack-env": "^1.13.6",
    "babel-preset-taro": "4.2.1",
